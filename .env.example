# Copy to server/.env and replace every placeholder before starting the server.
OPENAI_API_KEY=replace-with-your-server-side-key
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=replace-with-your-gemini-key
GEMINI_MODEL=gemini-3.6-flash
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional production settings
# PORT=5174
# CLIENT_ORIGIN=https://your-domain.example
# PROXY_KEY=
# DATABASE_URL=postgresql://user:password@host:5432/campusmate
# SYLLABUS_SOURCE_URL=https://your-approved-aktu-syllabus-api.example/cse
